<Project Sdk="Microsoft.NET.Sdk">

    <!-- Request, response and WebSocket types shared by the Service and its clients (the GUI's thin mode), so
         clients don't have to reference the whole web project. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>NicheImageRipper.Service</RootNamespace>
        <AssemblyName>NicheImageRipper.Service.Contracts</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Core\Core.csproj" />
    </ItemGroup>

</Project>
