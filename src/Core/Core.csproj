<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>NicheImageRipper.Core</RootNamespace>
        <Version>5.1.0</Version>
        <AssemblyVersion>$(Version).0</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Dapper" Version="2.1.89" />
      <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
      <PackageReference Include="Selenium.WebDriver" Version="4.52.0" />
      <PackageReference Include="Selenium.WebDriver.GeckoDriver" Version="0.37.1" />
      <PackageReference Include="Serilog" Version="4.4.0" />
      <PackageReference Include="SharpCompress" Version="0.50.9" />
      <PackageReference Include="System.Data.SQLite" Version="2.0.4" />
      <!-- System.Data.SQLite 2.x ships no native library; it P/Invokes e_sqlite3. Version kept in line with
           the one Microsoft.EntityFrameworkCore.Sqlite (Service) pulls in to avoid duplicate native assets. -->
      <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\lib\CSWebDriverClient\src\CSWebDriverClient\CSWebDriverClient.csproj" />
      <ProjectReference Include="..\..\lib\FlareSolverrIntegration\src\FlareSolverrIntegration\FlareSolverrIntegration.csproj" />
      <ProjectReference Include="..\..\lib\ImpersonateClient\src\ImpersonateClient\ImpersonateClient.csproj" />
      <ProjectReference Include="..\..\lib\Sdk\src\Sdk\Sdk.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="SiteParsing\HtmlParsers\" />
      <Folder Include="SiteParsing\VideoCapturers\" />
    </ItemGroup>

</Project>
