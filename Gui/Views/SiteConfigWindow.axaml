<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NicheImageRipper.Gui.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="NicheImageRipper.Gui.Views.SiteConfigWindow"
        x:DataType="vm:SiteConfigEditorViewModel"
        Title="Site Configs"
        WindowStartupLocation="CenterOwner"
        Width="900" Height="600" MinWidth="600" MinHeight="400">

    <Design.DataContext>
        <vm:SiteConfigEditorViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="240,*" RowDefinitions="*,Auto" Margin="15">
        <!-- Site list -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,0">
            <StackPanel DockPanel.Dock="Bottom" Spacing="5" Margin="0,10,0,0">
                <AutoCompleteBox Text="{Binding NewSiteName}"
                                 ItemsSource="{Binding KnownSiteNames}"
                                 FilterMode="ContainsOrdinal"
                                 PlaceholderText="Site name (e.g. pixiv)" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button Command="{Binding AddSiteCommand}">Add</Button>
                    <Button Command="{Binding RemoveSiteCommand}">Remove</Button>
                </StackPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite}"
                     BorderThickness="1" BorderBrush="Gray">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SiteConfigEntryViewModel">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Selected site editor -->
        <TextBlock Grid.Row="0" Grid.Column="1" IsVisible="{Binding !HasSelectedSite}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"
                   Text="Select a site or add one to edit its config." />
        <ScrollViewer Grid.Row="0" Grid.Column="1" IsVisible="{Binding HasSelectedSite}">
            <StackPanel DataContext="{Binding SelectedSite}" x:DataType="vm:SiteConfigEntryViewModel"
                        Spacing="8" Margin="0,0,15,0">
                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock IsVisible="{Binding !IsKnownSite}" Foreground="Orange" TextWrapping="Wrap"
                           Text="No loaded site module uses this name, so this config will be ignored." />

                <CheckBox IsChecked="{Binding HasLogin}">Login</CheckBox>
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" IsEnabled="{Binding HasLogin}"
                      Margin="25,0,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,10,5" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Username}" Margin="0,0,0,5" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Password}" PasswordChar="•"
                             RevealPassword="{Binding RevealPassword}" />
                    <ToggleButton Grid.Row="1" Grid.Column="2" IsChecked="{Binding RevealPassword}" Margin="5,0,0,0">Show</ToggleButton>
                </Grid>

                <TextBlock Text="API Key / Token:" />
                <TextBox Text="{Binding Key}" />

                <TextBlock Text="Cookies (one per line):" />
                <TextBox Text="{Binding CookiesText}" AcceptsReturn="True" TextWrapping="NoWrap"
                         MinHeight="60" MaxHeight="150" />

                <CheckBox IsChecked="{Binding HasOverrides}">Override Filename Scheme</CheckBox>
                <ComboBox Margin="25,0,0,0" IsEnabled="{Binding HasOverrides}"
                          ItemsSource="{Binding $parent[Window].((vm:SiteConfigEditorViewModel)DataContext).FilenameSchemes}"
                          SelectedItem="{Binding OverrideFilenameScheme}" />

                <TextBlock Text="Post-Process Script:" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding PostProcessScript}" PlaceholderText="Path to script run after a rip completes" />
                    <Button Grid.Column="1" Margin="5,0,0,0" Click="BrowsePostProcessScript">Browse</Button>
                </Grid>
                <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                           Text="Only runs when 'Run Post-Process Script' is enabled in Settings." />

                <TextBlock Text="Custom (JSON):" />
                <TextBox Text="{Binding CustomJson}" AcceptsReturn="True" FontFamily="Consolas,Menlo,monospace"
                         MinHeight="80" MaxHeight="200" PlaceholderText="Site-specific settings object, if the site uses one" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,15,0,0">
            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="IndianRed"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Click="Save" IsDefault="True">Save</Button>
                <Button Click="Cancel" IsCancel="True">Cancel</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
