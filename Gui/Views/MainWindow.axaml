<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NicheImageRipper.Gui.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NicheImageRipper.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModelBase"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}">
    
    <Window.Resources>
        <StreamGeometry x:Key="PauseButtonIcon">M520-200v-560h240v560H520Zm-320 0v-560h240v560H200Zm400-80h80v-400h-80v400Zm-320 0h80v-400h-80v400Zm0-400v400-400Zm320 0v400-400Z</StreamGeometry>
        <StreamGeometry x:Key="PlayButtonIcon">M320-200v-560l440 280-440 280Zm80-280Zm0 134 210-134-210-134v268Z</StreamGeometry>
    </Window.Resources>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModelBase />
    </Design.DataContext>

    <Grid x:Name="GridBackground" ColumnDefinitions="*" RowDefinitions="Auto, *" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Height="{Binding Height, RelativeSource={RelativeSource Self}}" Focusable="True">
        <StackPanel x:Name="TopPanel" Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="25">
            <TextBlock Text="Enter Url:" VerticalAlignment="Center" />
            <TextBox Text="{Binding UrlInput}" Width="500" Height="32" AcceptsReturn="True" TextChanged="OnUrlInput" IsReadOnly="{Binding Active}"/>
            <Button HotKey="Enter" Command="{Binding RipCommand}" IsEnabled="{Binding !Active}">Rip</Button>
            <Button Click="PlayPauseButton_OnClick"><PathIcon x:Name="PlayPauseButtonIcon" Data="{StaticResource PauseButtonIcon}"></PathIcon></Button>
            <Button Content="{Binding ConnectButtonDisplay}"
                    Command="{Binding ConnectCommand}"
                    IsVisible="{Binding IsThinClient}" />
        </StackPanel>
        <TabControl Grid.Row="1" Grid.Column="0" Margin="25">
            <TabItem Header="Logs">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="5,10,5,0">
                        <TextBlock x:Name="LogPausedText" Text="Scrolled up: new lines appear when you scroll to the bottom"
                                   Foreground="Gray" VerticalAlignment="Center" IsVisible="False" />
                        <Button Command="{Binding ClearLogCommand}">Clear</Button>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="LogTextBox" Margin="5" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             Classes.wrap="{Binding WrapLogLines}">
                        <TextBox.Styles>
                            <Style Selector="TextBox.wrap">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </TextBox.Styles>
                    </TextBox>
                </Grid>
            </TabItem>
            <TabItem Header="Queue">
                <Grid RowDefinitions="Auto, *" ColumnDefinitions="*">
                    <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="0,10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding DequeueUrlsCommand}" ToolTip.Tip="Remove the selected URLs (Delete)">
                                Remove Selected
                            </Button>
                            <Button Command="{Binding ClearQueueCommand}">Clear Queue</Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="15,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasCurrentUrl}"
                                   Text="{Binding CurrentUrl, StringFormat='Ripping: {0}'}"
                                   ToolTip.Tip="{Binding CurrentUrl}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding UrlCountText}" />
                    </Grid>
                    <ListBox Grid.Row="1" Grid.Column="0" x:Name="UrlQueue" SelectionMode="Multiple"
                             ItemsSource="{Binding UrlQueue}" SelectedItems="{Binding SelectedUrls, Mode=OneWay}">
                        <ListBox.KeyBindings>
                            <KeyBinding Gesture="Delete" Command="{Binding DequeueUrlsCommand}" />
                        </ListBox.KeyBindings>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="History">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Click="PreviousHistoryPage" IsEnabled="{Binding CanGoToPreviousHistoryPage}">Previous</Button>
                            <TextBox Text="{Binding CurrentHistoryPageDisplay}" LostFocus="UpdateCurrentHistoryPage" />
                            <Button Click="NextHistoryPage" IsEnabled="{Binding CanGoToNextHistoryPage}">Next</Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1" /> <!-- Spacer -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBox Text="{Binding HistoryFilterText}" Width="500" LostFocus="UpdateCurrentHistoryPageWithFilter" />
                            <Button Click="ClearHistoryFilter">Clear</Button>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" Margin="0, 10" ItemsSource="{Binding History}"
                              IsReadOnly="True"
                              KeyUp="HistoryDataGrid_OnKeyUp"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              GridLinesVisibility="All"
                              BorderThickness="1" BorderBrush="Gray">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding DirectoryName}" 
                                                Width="{Binding NameWidth}" Tag="HistoryName"
                                                PropertyChanged="OnHistoryColumnWidthChanged" />
                            <DataGridTextColumn Header="Url" Binding="{Binding Url}" 
                                                Width="{Binding UrlWidth}" Tag="HistoryUrl"
                                                PropertyChanged="OnHistoryColumnWidthChanged"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" 
                                                Width="{Binding DateWidth}" Tag="HistoryDate"
                                                PropertyChanged="OnHistoryColumnWidthChanged"/>
                            <DataGridTextColumn Header="#" Binding="{Binding NumUrls}"
                                                Width="{Binding CountWidth}" Tag="HistoryCount"
                                                PropertyChanged="OnHistoryColumnWidthChanged"/>
                            <DataGridTemplateColumn Header="Action">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Re-rip" 
                                                Command="{Binding ((vm:MainWindowViewModelBase)DataContext).ReRipUrlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding Url}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer>
                    <Grid ColumnDefinitions="Auto,400,Auto"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <Grid.Styles>
                            <Style Selector="TextBlock.header">
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Margin" Value="10,20,10,5" />
                            </Style>
                            <Style Selector="TextBlock.label">
                                <Setter Property="Margin" Value="10,5" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style Selector=":is(Control).value">
                                <Setter Property="Margin" Value="10,5" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </Grid.Styles>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Classes="header" Text="General" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Save Location:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding SavePath}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding SavePath}" />
                        <Button Grid.Row="1" Grid.Column="2" Classes="value" Click="SelectFolder">Browse</Button>
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Filename Scheme:" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Classes="value" ItemsSource="{Binding FilenameSchemes}"
                                  SelectedItem="{Binding FilenameScheme}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Unzip Protocol:" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Classes="value" ItemsSource="{Binding UnzipProtocols}"
                                  SelectedItem="{Binding UnzipProtocol}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="User Agent:" />
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Classes="value"
                                 Text="{Binding UserAgent, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Classes="header" Text="Downloading" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="Max Retries:" />
                        <TextBox Grid.Row="6" Grid.Column="1" Classes="value" x:Name="MaxRetriesTextBox" Text="{Binding MaxRetriesDisplay}"
                                 LostFocus="ValidateNumericValue" ToolTip.Tip="Total attempts per URL (minimum 1)" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Classes="label" Text="Retry Delay (ms):" />
                        <TextBox Grid.Row="7" Grid.Column="1" Classes="value" x:Name="RetryDelayTextBox" Text="{Binding RetryDelayDisplay}"
                                 LostFocus="ValidateNumericValue" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Classes="label" Text="Skip Failed Downloads:" />
                        <CheckBox Grid.Row="8" Grid.Column="1" Classes="value" IsChecked="{Binding SkipFailedDownloads}" />
                        <TextBlock Grid.Row="9" Grid.Column="0" Classes="label" Text="Remove Duplicate Files:" />
                        <CheckBox Grid.Row="9" Grid.Column="1" Classes="value" IsChecked="{Binding RemoveDuplicates}" />
                        <TextBlock Grid.Row="10" Grid.Column="0" Classes="label" Text="Run Post-Process Script:" />
                        <CheckBox Grid.Row="10" Grid.Column="1" Classes="value" IsChecked="{Binding RunPostProcessScript}"
                                  ToolTip.Tip="Runs each site's post-process script (set in Site Configs) after a rip completes" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" Classes="header" Text="Queue" />
                        <TextBlock Grid.Row="12" Grid.Column="0" Classes="label" Text="Save Unfinished Urls:" />
                        <CheckBox Grid.Row="12" Grid.Column="1" Classes="value" IsChecked="{Binding SaveUnfinishedUrls}" />
                        <TextBlock Grid.Row="13" Grid.Column="0" Classes="label" Text="Load Unfinished Urls:" />
                        <Button Grid.Row="13" Grid.Column="1" Classes="value" Click="SelectUnfinishedUrlFile">Browse</Button>

                        <TextBlock Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3" Classes="header" Text="External Services" />
                        <TextBlock Grid.Row="15" Grid.Column="0" Classes="label" Text="FlareSolverr URI:" />
                        <TextBox Grid.Row="15" Grid.Column="1" Classes="value"
                                 Text="{Binding FlareSolverrUri, UpdateSourceTrigger=LostFocus}" PlaceholderText="http://localhost:8191" />
                        <TextBlock Grid.Row="16" Grid.Column="0" Classes="label" Text="Close FlareSolverr Session:" />
                        <CheckBox Grid.Row="16" Grid.Column="1" Classes="value" IsChecked="{Binding CloseFlareSolverrSession}" />
                        <TextBlock Grid.Row="17" Grid.Column="0" Classes="label" Text="CSWebDriver URI:" />
                        <TextBox Grid.Row="17" Grid.Column="1" Classes="value"
                                 Text="{Binding CSWebDriverUri, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="3" Classes="header" Text="Sites" />
                        <TextBlock Grid.Row="19" Grid.Column="0" Classes="label" Text="Site Configs:" />
                        <TextBlock Grid.Row="19" Grid.Column="1" Classes="value"
                                   Text="{Binding SiteConfigCount, StringFormat='{}{0} site(s) configured'}" />
                        <Button Grid.Row="19" Grid.Column="2" Classes="value" Command="{Binding EditSiteConfigsCommand}">Edit…</Button>

                        <TextBlock Grid.Row="20" Grid.Column="0" Grid.ColumnSpan="3" Classes="header" Text="Log Tab" />
                        <TextBlock Grid.Row="21" Grid.Column="0" Classes="label" Text="Show Timestamp and Level:" />
                        <CheckBox Grid.Row="21" Grid.Column="1" Classes="value" IsChecked="{Binding ShowLogTimestampAndLevel}"
                                  ToolTip.Tip="Only affects the log tab; the log file always includes them" />
                        <TextBlock Grid.Row="22" Grid.Column="0" Classes="label" Text="Show Debug Messages:" />
                        <CheckBox Grid.Row="22" Grid.Column="1" Classes="value" IsChecked="{Binding ShowDebugLogs}" />
                        <TextBlock Grid.Row="23" Grid.Column="0" Classes="label" Text="Wrap Long Lines:" />
                        <CheckBox Grid.Row="23" Grid.Column="1" Classes="value" IsChecked="{Binding WrapLogLines}" />

                        <TextBlock Grid.Row="24" Grid.Column="0" Grid.ColumnSpan="3" Classes="header" Text="Maintenance" />
                        <TextBlock Grid.Row="25" Grid.Column="0" Classes="label" Text="Clear Cache:" />
                        <Button Grid.Row="25" Grid.Column="1" Classes="value" Command="{Binding ClearCacheCommand}">Clear</Button>
                        <TextBlock Grid.Row="26" Grid.Column="0" Classes="label" Text="Check For Updates:" />
                        <Button Grid.Row="26" Grid.Column="1" Classes="value" Command="{Binding CheckForUpdatesCommand}">Check</Button>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>

</Window>